# Normalize line endings and diff behavior across platforms.

* text=auto

# Python source: LF, diffable.
*.py text eol=lf diff=python

# Docs and data: LF.
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# SQLite / binary artifacts (if ever present locally): not text.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
