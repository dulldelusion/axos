# --- AXOS runtime state (created by scripts/bootstrap/) ---
.axos-state/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Test / coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- SQLite runtime artifacts (never commit databases) ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# --- OS / editor ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
.vscode/
*.orig
*.rej

# --- Secrets (defense in depth; the pre-push audit also scans) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
*_secret*.json
